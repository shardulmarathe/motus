{
  // Public URL rather than node_modules: wrangler is deliberately NOT a
  // dependency of this project — see the note in package.json's versus:*
  // scripts — so there is no local copy of the schema to point at.
  "$schema": "https://unpkg.com/wrangler@4.86.0/config-schema.json",
  "name": "motus-versus",
  "main": "worker/index.ts",
  // Must not be newer than the workerd binary bundled with the installed
  // wrangler, or `wrangler dev` refuses to start.
  "compatibility_date": "2026-05-01",

  // One Durable Object per room code — the code is the object name, so every
  // player entering the same code lands on the same instance.
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "MotusVersusRoom" }]
  },

  // `new_sqlite_classes` (rather than `new_classes`) is required for Durable
  // Objects on the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MotusVersusRoom"] }],

  "observability": { "enabled": true }
}
