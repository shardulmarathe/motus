# Copy to .env.local and fill in values from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Optional: dedicated secret for signed game sessions (falls back to service role key)
LEADERBOARD_SESSION_SECRET=your_random_secret_here
