# Copy to .env.local and fill in values from Neon → Connection details
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Random secret for signing survival game sessions (generate with: openssl rand -base64 32)
LEADERBOARD_SESSION_SECRET=your_random_secret_here

# Online Versus relay (optional). Host of the deployed Cloudflare Worker, e.g.
# motus-versus.your-name.workers.dev — deploy it with `npm run versus:deploy`.
# Unset = localhost:1999, which is where `npm run versus:dev` listens.
# This is a NEXT_PUBLIC_ value, so it is baked in at build time: changing it in
# Vercel requires a redeploy to take effect.
NEXT_PUBLIC_VERSUS_HOST=
